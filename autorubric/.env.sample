# Backend Settings
# Generate a secret key (e.g. using `openssl rand -hex 32`)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URL
# You can use a local PostgreSQL database or a managed one (e.g. Supabase, RDS)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autorubric

# Redis URL for Celery broker and result backend
# Get this from a local Redis instance or a managed service (e.g. Upstash, ElastiCache)
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Required for pipeline execution)
# You can get an OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM to use
LLM_MODEL_NAME=gpt-4-turbo

# Frontend Settings (NEXT_PUBLIC_...)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
