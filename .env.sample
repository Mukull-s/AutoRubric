# AutoRubric Environment Variables Sample
# Copy this file to `.env` in the respective directories and update the values.

# ==============================================================================
# FRONTEND (.env.local)
# Location: autorubric/frontend/.env.local
# ==============================================================================

# URL for the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to use mock service worker (MSW) data, or "false" to hit the real backend API.
NEXT_PUBLIC_USE_MOCKS=false


# ==============================================================================
# BACKEND (.env)
# Location: autorubric/backend/.env
# ==============================================================================

# Database and Cache Connections
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autorubric
REDIS_URL=redis://localhost:6379/0

# Security and Auth
SECRET_KEY=supersecret
JWT_SECRET=jwtsecret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin User Setup
ADMIN_EMAIL=admin@example.com
# The default hash is for the password 'admin'
ADMIN_PASSWORD_HASH=$2b$12$XnPs0wsVFTB9pj5EANy8wuW7NGlE2TyUPfqMsLotDLj7M6KBevWsi

# File Storage
UPLOADS_DIR=/app/uploads

# Pipeline Configuration (mock vs real execution)
STAGE_EXTRACTION_MODE=real
STAGE_SEGMENTATION_MODE=real
STAGE_RETRIEVAL_MODE=real
STAGE_EVALUATION_MODE=real
STAGE_AUDIT_MODE=real
STAGE_ANNOTATION_MODE=real

# Evaluator Backend Options (mock, cpu, gpu)
EVALUATOR_BACKEND=cpu
